{
  // Local development only (`wrangler dev`, `pnpm run dev:all`). This agent is
  // not deployed to any environment; the demo fleet covers the deployed ones.
  "name": "spellguard-agent-d",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 8790,
    "inspector_port": 9233
  },
  "vars": {
    // Agent Identity
    "SELF_URL": "http://localhost:8790",
    "AGENT_ID": "agent-d",
    "CODE_HASH": "sha256:dev-placeholder",
    // Management server for discovery + Verifier registration
    "MANAGEMENT_URL": "http://localhost:3001/v1",
    // Fallback Verifier URL (used when MANAGEMENT_URL isn't set)
    "VERIFIER_URL": "http://localhost:46358",
    "SPELLGUARD_PROFILE": "agntcy"
  }
  // Secrets (local: .env in this package, copied from .env.example):
  // - OPENROUTER_API_KEY
  // - SPELLGUARD_AGENT_SECRET
}
