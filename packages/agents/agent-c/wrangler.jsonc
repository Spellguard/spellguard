{
  // Local development only (`wrangler dev`, `pnpm run dev:all`). This agent is no
  // longer deployed to any environment: the demo fleet replaced it, and its
  // Workers were deleted on 2026-11-02.
  "name": "spellguard-agent-c",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 8789,
    "inspector_port": 9231
  },
  "vars": {
    // Agent Identity
    "SELF_URL": "http://localhost:8789",
    "AGENT_ID": "agent-c",
    "SPELLGUARD_PROFILE": "agntcy"
  }
  // Note: Agent C does NOT use Spellguard - it's a standard A2A agent
  // This is intentional for testing one-sided integration
  // Secrets (local: .env in this package, copied from .env.example):
  // - OPENROUTER_API_KEY
}
