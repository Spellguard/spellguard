{
  // LLM-scope secret-egress policy — governs the model-inference leg (scope:'llm').
  // Blocks secrets/credentials in BOTH the prompt sent to the model AND the
  // completion returned from it: the gateway must never forward a leaked API key
  // to the provider, nor hand a model-emitted credential back to the caller. This
  // is unique to the LLM gateway — the message/tool legs never see the raw model
  // prompt or completion.
  //
  // level:'org' + recommended → OPT-IN (bindable via an explicit binding or an
  // industry preset), NOT auto-applied fleet-wide by applyDefaults (which only
  // pulls level:'system'). scope:'llm' means the Verifier's filterByScope applies
  // it ONLY on the inference leg. direction:'both' → checked on both the outbound
  // prompt (cfg.outbound) and the inbound completion (cfg.inbound).
  //
  // Config mirrors the system secrets-baseline (BuiltinEngine type:'secrets'):
  // credential categories + the AWS/SSN/credit-card customPatterns. The secrets
  // engine is pure regex (inline-safe, no model round-trip) and emits spans.
  "policies": [
    {
      "slug": "llm-secrets-egress",
      "name": "LLM Secret Egress Block",
      "description": "Blocks secrets and credentials (API keys, tokens, private keys, AWS/Stripe/GitHub keys, SSN/credit-card numbers) in the prompt sent to the model and in the model's completion, on the LLM-gateway leg.",
      "type": "secrets",
      "level": "org",
      "severity": "critical",
      "failBehavior": "block",
      "config": {
        // NO `categories` key → every built-in secret category is checked. It
        // previously listed all 11 explicitly, which is identical TODAY but
        // silently excludes any category the engine gains later — a
        // false-negative that shows up as "nothing happened".
        "customPatterns": [
          "\\bsk-[A-Za-z0-9]{20,}\\b",
          "\\b(password|passwd|pwd)\\s+\\w+\\s+\\S{8,}",
          "\\b\\d{4}[-\\s]?\\d{4}[-\\s]?\\d{4}[-\\s]?\\d{4}\\b",
          "\\b\\d{3}-\\d{2}-\\d{4}\\b"
        ],
        "label": "llm-secrets"
      },
      "defaultBinding": {
        "direction": "both",
        "effect": "block",
        "priority": 90,
        "scope": "llm"
      },
      "provenance": {
        "source": "spellguard:llm-gateway",
        "dateAdded": "2026-07-20",
        "reference": "internal design notes"
      }
    }
  ]
}
