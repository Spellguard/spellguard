// Cross-tool meta policies — scoped `tools` ON PURPOSE (see
// tool-database-policies.jsonc for the full rationale). `output-size-limit` is the
// starkest case: an LLM prompt is legitimately far larger than a tool result, so an
// unscoped size cap with effect `block` fires on ordinary inference traffic.
{
  "policies": [
    {
      "slug": "output-size-limit-baseline",
      "name": "Tool Output Size Limit",
      "description": "Flags oversized tool outputs for review without blocking legitimate large reads",
      "type": "output-size-limit",
      "level": "system",
      "severity": "low",
      "failBehavior": "block",
      "config": {},
      "defaultBinding": {
        "scope": "tools",
        "direction": "both",
        "effect": "flag",
        "priority": 80
      },
      "provenance": {
        "source": "extracted:policy-meta-engine",
        "dateAdded": "2026-03-16",
        "reference": "packages/verifier/src/proxy/policy-meta-engine.ts:evaluateToolOutputSizeLimit"
      }
    },
    {
      "slug": "data-flow-taint-baseline",
      "name": "Cross-Tool Data Flow Taint Detection",
      "description": "Detects recent untrusted external inputs flowing into privileged tool invocations within the look-back window",
      "type": "data-flow-taint",
      "level": "system",
      "severity": "critical",
      "failBehavior": "block",
      "config": {
        "windowSeconds": 60
      },
      "defaultBinding": {
        "scope": "tools",
        "direction": "both",
        "effect": "block",
        "priority": 90
      },
      "provenance": {
        "source": "extracted:policy-meta-engine",
        "dateAdded": "2026-03-16",
        "reference": "packages/verifier/src/proxy/policy-meta-engine.ts:evaluateCrossToolDataFlow"
      }
    }
  ]
}
